# ============================================================
# Backend (Express) environment variables
# Copy this file to "server/.env" and adjust the values.
# ============================================================

# Port the Express API server listens on
PORT=4000

# Secret used to sign JWT auth tokens. CHANGE THIS in production!
JWT_SECRET=change-this-to-a-long-random-secret-string

# How long an auth token stays valid (e.g. 1h, 12h, 7d)
JWT_EXPIRES_IN=12h

# Number of bcrypt salt rounds for password hashing (local DB fallback only)
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------
# Supabase Auth (preferred for register / login)
# Project: https://xakmpzrpmawzojplvunm.supabase.co
# ------------------------------------------------------------
SUPABASE_URL=https://xakmpzrpmawzojplvunm.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# Optional aliases (same values)
# NEXT_PUBLIC_SUPABASE_URL=https://xakmpzrpmawzojplvunm.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# Required for merchant credentials vault (CRUD on merchant_vault / merchant_credentials)
# Get from Supabase Dashboard → Project Settings → API → service_role
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxx

# Optional: vault unlock JWT lifetime (default 30m)
# VAULT_TOKEN_EXPIRES_IN=30m

# WebAuthn / Touch ID (local defaults work for Vite on localhost:5173)
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=Simulator Merchant
# WEBAUTHN_ORIGIN=http://localhost:5173
# Production example:
# WEBAUTHN_RP_ID=simulator-merchant.vercel.app
# WEBAUTHN_ORIGIN=https://simulator-merchant.vercel.app

# Path (relative to the server folder) to the CSV file that stores users (legacy; auto-migrated to DB)
USERS_CSV_PATH=data/users.csv

# Local SQLite database path (fallback when Supabase is not configured)
USERS_DB_PATH=data/users.db

# Optional Postgres connection string (custom tables / advanced)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xakmpzrpmawzojplvunm.supabase.co:5432/postgres
# DATABASE_SSL=true

# Comma-separated list of allowed CORS origins (frontend URLs).
# Use * to allow any origin (fine for local development).
CORS_ORIGIN=http://localhost:5173

# SPA origin for payment callback redirects (local dev: Vite on 5173, API on 4000)
DEV_FRONTEND_URL=http://localhost:5173

# Production: set to your deployed app URL so callback redirects always hit your SPA
# PUBLIC_APP_URL=https://simulator-merchant.vercel.app
